MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=soft_shop
MYSQL_USER=soft_shop
MYSQL_PASSWORD=changeme
MYSQL_PORT=3306

# Used by the app's server-side API to reach the container from the host
MYSQL_HOST=localhost

# Secret used to sign/encrypt the admin dashboard's session cookie — must be
# at least 32 random characters. Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=changeme_at_least_32_characters_long

# Same idea, but for the customer (storefront) session cookie — keep this
# DIFFERENT from ADMIN_SESSION_SECRET so a leak of one doesn't compromise the other.
SESSION_SECRET=changeme_at_least_32_characters_long_too

# SuperFrete (cálculo de frete real por CEP no checkout). Gere o token em
# https://sandbox.superfrete.com/#/integrations (teste) ou
# https://web.superfrete.com/#/integrations (produção) → "Integrar em
# Desenvolvedores". CEP de origem é o do endereço de onde os produtos saem.
SUPERFRETE_BASE_URL=https://sandbox.superfrete.com
SUPERFRETE_TOKEN=changeme
SUPERFRETE_CEP_ORIGEM=00000000

# URL pública onde o site está servindo (sem barra no final). Usada pra
# montar os links de retorno do checkout, o endereço de webhook informado
# aos gateways de pagamento e o link de confirmação de e-mail. Em produção,
# aponte pro seu domínio real.
SITE_URL=http://localhost:8080

# Resend (envio do e-mail de verificação de cadastro). Crie uma conta em
# https://resend.com, pegue a API key em API Keys → Create API Key.
RESEND_API_KEY=changeme
# Remetente usado nos e-mails. Sem domínio próprio verificado no Resend, use
# o remetente de teste "onboarding@resend.dev" (só entrega pro e-mail da
# conta Resend); em produção, verifique seu domínio e troque aqui.
RESEND_FROM_EMAIL=Soft Shop <onboarding@resend.dev>

# Mercado Pago (checkout hospedado — Pix, boleto e cartão). Crie uma
# aplicação de teste em https://www.mercadopago.com.br/developers/panel/app
# e pegue o Access Token de teste em "Credenciais de teste".
MERCADOPAGO_ACCESS_TOKEN=changeme
# Opcional mas recomendado antes de ir pra produção: painel da aplicação →
# Webhooks → "Assinatura secreta". Sem isso, qualquer um que descubra a URL
# do webhook consegue fingir um pagamento aprovado.
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe (checkout hospedado — cartão). Chave secreta de teste em
# https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=changeme
# Crie um endpoint em https://dashboard.stripe.com/test/webhooks apontando
# pra SITE_URL/webhooks/stripe, eventos "checkout.session.completed" e
# "checkout.session.expired" — o segredo de assinatura fica lá.
# Em dev, use `stripe listen --forward-to localhost:8080/webhooks/stripe`
# (Stripe CLI) pra receber webhooks sem expor sua máquina.
STRIPE_WEBHOOK_SECRET=changeme

# --- Produção (Vercel) ---
# Configure estas variáveis no painel da Vercel (Settings → Environment
# Variables), nunca neste arquivo. Deixe em branco/local para desenvolvimento.

# Aponte MYSQL_HOST/PORT/USER/PASSWORD/DATABASE pro banco gerenciado (ex:
# Railway) em vez do container Docker local, e ligue TLS:
# MYSQL_SSL=true

# Token de leitura/escrita do Vercel Blob (gerado automaticamente ao conectar
# um Blob Store ao projeto na Vercel — não precisa criar manualmente):
# BLOB_READ_WRITE_TOKEN=
